{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env*": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "**/.env*": "deny"
    },
    "grep": {
      "*": "allow",
      ".env": "deny",
      "**/.env*": "deny"
    },
    "glob": {
      "*": "allow",
      ".env": "deny",
      "**/.env*": "deny"
    },
    "bash": {
      "*": "allow",
      "*cat .env*": "deny",
      "*Get-Content .env*": "deny",
      "*type .env*": "deny",
      "*more .env*": "deny"
    }
  }
}
