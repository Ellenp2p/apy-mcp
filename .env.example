# GitHub OAuth (required for GitHub login)
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub access control allowlist (comma-separated usernames or numeric UIDs)
# When empty, ALL GitHub users can log in. For production you SHOULD set this.
# Example: ALLOWED_GITHUB_USERS=octocat,583231
ALLOWED_GITHUB_USERS=

# Public base URL for OAuth redirects (required behind a reverse proxy / TLS)
# Example: BASE_URL=https://mcp.example.com
BASE_URL=https://mcp.example.com

# Alchemy API key - used for ALL EVM chains (ethereum, polygon, arbitrum, optimism,
# avalanche, base, gnosis, bnb, scroll, zksync, sonic) with a single key.
# Create at: https://dashboard.alchemy.com/apps
ALCHEMY_KEY=your_alchemy_key

# Admin API token (REQUIRED for production - admin endpoints are open without it)
ADMIN_TOKEN=your_admin_token
